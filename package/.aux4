{
  "scope": "aux4",
  "name": "mock",
  "version": "0.0.3",
  "description": "Programmable HTTP mock server built on aux4/api for mocking external APIs in tests",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "mock",
    "http",
    "test",
    "api"
  ],
  "dependencies": [
    "aux4/api"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "mock",
          "execute": [
            "profile:mock"
          ],
          "help": {
            "text": "Programmable HTTP mock server for tests"
          }
        }
      ]
    },
    {
      "name": "mock",
      "commands": [
        {
          "name": "start",
          "execute": [
            "${packageDir}/aux4-mock start param(port) param(name) param(stateDir) param(timeout)"
          ],
          "help": {
            "text": "Start a mock server (launches aux4/api with a catch-all route, detached)",
            "variables": [
              {
                "name": "port",
                "text": "Port to run the mock server on (0 or auto = pick a free port; empty selects a free port when --name is set, else 7070)",
                "default": ""
              },
              {
                "name": "name",
                "text": "Stable handle to address this server later without knowing its port",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (default: ${TMPDIR:-/tmp}/aux4-mock/name-<name> or /<port>)",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Per-request handler timeout in milliseconds",
                "default": "15000"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "${packageDir}/aux4-mock stop param(port) param(name) param(stateDir)"
          ],
          "help": {
            "text": "Stop the mock server and clean up its state directory",
            "variables": [
              {
                "name": "port",
                "text": "Port of the mock server to stop",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server to stop (reads its persisted port)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "stub",
          "execute": [
            "stdin:${packageDir}/aux4-mock stub param(port) param(name) param(stateDir) param(method) param(path) param(status) param(body) param(bodyFile) param(contentType) param(header**) param(when-header**) param(when-query**) param(when-body-contains)"
          ],
          "help": {
            "text": "Define or replace a stub response (matched by method + path, optional request predicates)",
            "variables": [
              {
                "name": "port",
                "text": "Port of the mock server (derives stateDir)",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server (derives stateDir; no --port needed)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory",
                "default": ""
              },
              {
                "name": "method",
                "text": "HTTP method to match (ANY matches any method)",
                "default": "ANY"
              },
              {
                "name": "path",
                "text": "Request path to match (required)"
              },
              {
                "name": "status",
                "text": "Response status code",
                "default": "200"
              },
              {
                "name": "body",
                "text": "Inline response body (else --bodyFile, else stdin)",
                "default": ""
              },
              {
                "name": "bodyFile",
                "text": "File to read the response body from",
                "default": ""
              },
              {
                "name": "contentType",
                "text": "Response Content-Type (JSON body defaults to application/json)",
                "default": ""
              },
              {
                "name": "header",
                "text": "Response header as key=value (repeatable)",
                "default": "",
                "multiple": true
              },
              {
                "name": "when-header",
                "text": "Only match when a request header equals key=value; value may end with * as a wildcard (repeatable)",
                "default": "",
                "multiple": true
              },
              {
                "name": "when-query",
                "text": "Only match when a request query param equals key=value (repeatable)",
                "default": "",
                "multiple": true
              },
              {
                "name": "when-body-contains",
                "text": "Only match when the request body contains this substring",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "preset",
          "execute": [
            "profile:mock:preset"
          ],
          "help": {
            "text": "Apply a service preset to a running mock. Presets are installable packages (community/mock-preset-<service>) that add commands here."
          }
        },
        {
          "name": "presets",
          "execute": [
            "${packageDir}/aux4-mock presets"
          ],
          "help": {
            "text": "List the service presets available under 'mock preset' (from installed community/mock-preset-<service> packages)"
          }
        },
        {
          "name": "reset",
          "execute": [
            "${packageDir}/aux4-mock reset param(port) param(name) param(stateDir) param(stubs) param(requests)"
          ],
          "help": {
            "text": "Clear stubs and/or recorded requests (default: both)",
            "variables": [
              {
                "name": "port",
                "text": "Port of the mock server (derives stateDir)",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server (derives stateDir; no --port needed)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory",
                "default": ""
              },
              {
                "name": "stubs",
                "text": "Clear only stubs when set to true",
                "default": ""
              },
              {
                "name": "requests",
                "text": "Clear only recorded requests when set to true",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "requests",
          "execute": [
            "${packageDir}/aux4-mock requests param(port) param(name) param(stateDir) param(method) param(path)"
          ],
          "help": {
            "text": "Print recorded requests as a JSON array (optionally filtered)",
            "variables": [
              {
                "name": "port",
                "text": "Port of the mock server (derives stateDir)",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server (derives stateDir; no --port needed)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory",
                "default": ""
              },
              {
                "name": "method",
                "text": "Filter recorded requests by method",
                "default": ""
              },
              {
                "name": "path",
                "text": "Filter recorded requests by path",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "verify",
          "execute": [
            "${packageDir}/aux4-mock verify param(port) param(name) param(stateDir) param(method) param(path) param(times) param(body-contains**) param(header**)"
          ],
          "help": {
            "text": "Assert a matching request was recorded (exit non-zero on failure)",
            "variables": [
              {
                "name": "port",
                "text": "Port of the mock server (derives stateDir)",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server (derives stateDir; no --port needed)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory",
                "default": ""
              },
              {
                "name": "method",
                "text": "Match recorded requests by method",
                "default": ""
              },
              {
                "name": "path",
                "text": "Match recorded requests by path",
                "default": ""
              },
              {
                "name": "times",
                "text": "Exact number of matches expected (omit = at least 1)",
                "default": ""
              },
              {
                "name": "body-contains",
                "text": "Require the request body to contain this substring (repeatable; all must be present, AND)",
                "default": "",
                "multiple": true
              },
              {
                "name": "header",
                "text": "Require a request header as key=value (repeatable)",
                "default": "",
                "multiple": true
              }
            ]
          }
        },
        {
          "name": "respond",
          "private": true,
          "execute": [
            "stdin:${packageDir}/aux4-mock respond param(stateDir) param(port)"
          ],
          "help": {
            "text": "Mounted catch-all handler: reads the request event on stdin and prints the stubbed response",
            "variables": [
              {
                "name": "stateDir",
                "text": "State directory for the stub store and request journal",
                "default": ""
              },
              {
                "name": "port",
                "text": "Server port (used to derive stateDir when not explicit)",
                "default": "7070"
              }
            ]
          }
        },
        {
          "name": "command",
          "execute": [
            "${packageDir}/aux4-mock command param(name) param(stateDir) param(command) param(output) param(outputFile) param(exitCode) param(param**)"
          ],
          "help": {
            "text": "Stub an aux4 command so it returns a canned result instead of running (prints the AUX4_AUX4_FILES path to export)",
            "variables": [
              {
                "name": "name",
                "text": "Stable handle for this set of stubs (derives stateDir)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (no server involved)",
                "default": ""
              },
              {
                "name": "command",
                "text": "Command pattern to stub, as profile/command (e.g. google:gmail/list); * is a per-segment wildcard",
                "default": "",
                "arg": true
              },
              {
                "name": "output",
                "text": "Text the stubbed command prints",
                "default": ""
              },
              {
                "name": "outputFile",
                "text": "File whose contents the stubbed command prints (use for JSON or multi-line output)",
                "default": ""
              },
              {
                "name": "exitCode",
                "text": "Exit code the stubbed command returns",
                "default": "0"
              },
              {
                "name": "param",
                "text": "Only stub when a parameter matches, as key=value (repeatable)",
                "default": "",
                "multiple": true
              }
            ]
          }
        },
        {
          "name": "record",
          "private": true,
          "execute": [
            "${packageDir}/aux4-mock record param(name) param(stateDir) param(stub) param(command) param(commandLine) param(params)"
          ],
          "help": {
            "text": "Internal: called by a stub's replace hook to record the call and print the stubbed output",
            "variables": [
              {
                "name": "name",
                "text": "Stable handle for this set of stubs (derives stateDir)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (no server involved)",
                "default": ""
              },
              {
                "name": "stub",
                "text": "Id of the stub standing in for the command",
                "default": ""
              },
              {
                "name": "command",
                "text": "Command that was called",
                "default": ""
              },
              {
                "name": "commandLine",
                "text": "Command line as typed",
                "default": ""
              },
              {
                "name": "params",
                "text": "Parameters as typed",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "invocations",
          "execute": [
            "${packageDir}/aux4-mock invocations param(name) param(stateDir)"
          ],
          "help": {
            "text": "Print recorded command invocations as a JSON array",
            "variables": [
              {
                "name": "name",
                "text": "Stable handle for this set of stubs (derives stateDir)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (no server involved)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "verify-command",
          "execute": [
            "${packageDir}/aux4-mock verify-command param(name) param(stateDir) param(command) param(times) param(params-contains**)"
          ],
          "help": {
            "text": "Assert a stubbed command was called (exit non-zero on failure)",
            "variables": [
              {
                "name": "name",
                "text": "Stable handle for this set of stubs (derives stateDir)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (no server involved)",
                "default": ""
              },
              {
                "name": "command",
                "text": "Match recorded invocations by command",
                "default": "",
                "arg": true
              },
              {
                "name": "times",
                "text": "Exact number of matches expected (omit = at least 1)",
                "default": ""
              },
              {
                "name": "params-contains",
                "text": "Require the parameters to contain this substring (repeatable; all must be present, AND)",
                "default": "",
                "multiple": true
              }
            ]
          }
        },
        {
          "name": "reset-commands",
          "execute": [
            "${packageDir}/aux4-mock reset-commands param(name) param(stateDir) param(stubs) param(invocations)"
          ],
          "help": {
            "text": "Clear command stubs and recorded invocations (no server involved)",
            "variables": [
              {
                "name": "name",
                "text": "Stable handle for this set of stubs (derives stateDir)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (no server involved)",
                "default": ""
              },
              {
                "name": "stubs",
                "text": "Clear command stubs only (true)",
                "default": ""
              },
              {
                "name": "invocations",
                "text": "Clear recorded invocations only (true)",
                "default": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "mock:preset",
      "commands": []
    }
  ]
}
